use Test;
use OneFit::Engine::Blocks;

# A block's "# fit if CONDITION, STEP" / "# plot if CONDITION, STEP" line:
# without the step the condition is ignored, with a warning (it used to
# leave an empty condition behind, and the fit died later).
my class Capture { has @.lines; method print(\s) { @!lines.push(s) } }
sub block(Str $line) {
    "# DATA N= 300\n# TAG = b1\n$line\n0 1 0.1\n1 2 0.1\n3 4 0.1\n5 6 0.1\n"
}
sub read(Str $text) {
    my $*ERR = Capture.new;
    my $b = Block.new.read($text);
    ($b, $*ERR.lines.join);
}

plan 6;
my ($b, $err) = read(block("# fit if c1<2, 1"));
is $b.select(:fit).Export-data.elems, 2, 'fit if CONDITION, STEP keeps the matching rows';
is $err, '', '... without a warning';

($b, $err) = read(block("# fit if c1<2"));
is $b.select(:fit).Export-data.elems, 4, 'fit if without a step: the condition is ignored, every row kept';
like $err, /'needs CONDITION,STEP'/, '... with a warning';

($b, $err) = read(block("# plot if c1<2"));
is $b.select(:plot).Export-data.elems, 4, 'plot if without a step: ignored, every row kept';
like $err, /'needs CONDITION,STEP'/, '... with a warning';
