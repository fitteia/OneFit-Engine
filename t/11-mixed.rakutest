#!/usr/bin/env raku

my $time = BEGIN { now }
END { say "Total execution time (s): " , now - INIT now }

say "Compile time: ", now - $time;

use OneFit;
use OneFit::Engine::Stpfiles;
use Test;

# INSTALL (makefile) puts the install path here; run from a checkout, it is the checkout itself.
our constant OFE-PATH = do { my $p = "%OFE-PATH%"; $p.starts-with("%") ?? $?FILE.IO.absolute.IO.parent.parent.Str !! $p };

my $workfolder="/tmp/OneFit-Engine-test";
$workfolder.IO.mkdir unless $workfolder.IO.d; # INSTALL creates it; so does a run on its own
my $test-path=OFE-PATH ~ "/t";

my class OutputCapture {
    has @!lines;
    
    method print (\s) { @!lines.append(s) }
    method captured () { @!lines.join }
}

plan 2;

$time = now;
my $eng = Engine.new.path("$workfolder").read("$test-path/9/Master-MIXED.sav").fit.save("$workfolder/Master-MIXED.json");
is "$workfolder/Master-MIXED.json".IO.e, True, "mixed fit finish ok! ({ now -$time } s)" ;;

# The results saved in the fit file (SimulFitOutput) are the printed ones
# (fit-results), block by block - not one parameter set repeated (it was:
# the second pass took the MIXED fit for a plain global one).
{
    use JSON::Fast;
    my %saved = from-json("$workfolder/Master-MIXED.json".IO.slurp);
    my &rows = { $^t.lines.grep({ .so && !.starts-with('#') }).map({ .split(/<[,\s]>+/).grep(*.chars).join(' ') }).List };
    is-deeply rows(%saved<SimulFitOutput>), rows(%saved<fit-results>), "saved MIXED results are the printed ones, block by block";
}

