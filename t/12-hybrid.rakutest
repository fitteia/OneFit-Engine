#!/usr/bin/env raku

my $time = BEGIN { now }
END { say "Total execution time (s): " , now - INIT now }

say "Compile time: ", now - $time;

use OneFit;
use OneFit::Engine::Stpfiles;
use Test;

# INSTALL (makefile) puts the install path here; run from a checkout, it is the checkout itself.
our constant OFE-PATH = do { my $p = "%OFE-PATH%"; $p.starts-with("%") ?? $?FILE.IO.absolute.IO.parent.parent.Str !! $p };

my $workfolder="/tmp/OneFit-Engine-test";
$workfolder.IO.mkdir unless $workfolder.IO.d; # INSTALL creates it; so does a run on its own
my $test-path=OFE-PATH ~ "/t";

my class OutputCapture {
    has @!lines;
    
    method print (\s) { @!lines.append(s) }
    method captured () { @!lines.join }
}

plan 3;

$time = now;
# MINUIT's parameter limit: the install record (onefite-c-code's engine.pl
# writes etc/engine.json and puts d506cm.inc back to its committed value),
# else, for an engine installed before engine.pl, minuit's d506cm.inc.
sub minuit-limit {
    my $rec = "{ OFE-PATH }/etc/engine.json".IO;
    return +$0 if $rec.e and $rec.slurp ~~ / '"max_params"' \s* ':' \s* (\d+) /;
    my $inc = "{ OFE-PATH }/../minuit/minuit/d506cm.inc".IO;
    return +$0 if $inc.e and $inc.slurp ~~ / 'MNI=' (\d+) /;
    0
}
cmp-ok minuit-limit(), '>=', 225, "hybrid fit test can only be performed when INSTALL ... --minuit=225 ({ now -$time } s)" ; 

$time = now;
my $eng = Engine.new.path("$workfolder").read("$test-path/12/p96.json").fit( :hybrid ).save("$workfolder/hybrid.json");
is "$workfolder/hybrid.json".IO.e, True, "hybrid fit finish ok! ({ now -$time } s)" ;

$time = now;
shell("{ ::('OFE-PATH') }/../bin/pdf2mp4 All.mp4 All.pdf > pdf2mp4.log 2>&1",:cwd("$workfolder"));
is "$workfolder/All.mp4".IO.e, True, "mp4 generate ok! ({ now -$time } s)" ;

